<Page
    x:Class="ImmichWin.App.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*" Background="Black" KeyDown="OnKeyDown" IsTabStop="True" x:Name="Root">
        <Grid Padding="8" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Background="#CC000000">
            <Button Content="← Back" Click="OnBack" />
            <TextBlock x:Name="NameText" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Content="Load original" Click="OnOriginal" x:Name="OrigBtn" Margin="4,0" />
            <Button Grid.Column="3" Content="◀" Click="OnPrev" Margin="4,0" />
            <Button Grid.Column="4" Content="▶" Click="OnNext" />
        </Grid>
        <Image x:Name="Pic" Grid.Row="1" Stretch="Uniform" />
        <ProgressRing x:Name="Busy" Grid.Row="1" IsActive="False" Width="40" Height="40" />
        <TextBlock x:Name="Msg" Grid.Row="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>

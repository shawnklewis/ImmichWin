<Window
    x:Class="ImmichWin.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="ImmichWin">
    <Grid>
        <tb:TaskbarIcon x:Name="Tray" ToolTipText="ImmichWin" MenuActivation="RightClick" NoLeftClickDelay="True">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="I" FontSize="34" Foreground="White" Background="#2D5AC8" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open ImmichWin" Click="OnTrayShow" />
                    <MenuFlyoutItem Text="Quit" Click="OnTrayQuit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" SelectionChanged="OnNavChanged" IsPaneOpen="True" OpenPaneLength="200">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Timeline" Tag="timeline" Icon="Pictures" />
                <NavigationViewItem Content="Albums" Tag="albums" Icon="Library" />
                <NavigationViewItem Content="Activity" Tag="activity" Icon="Message" />
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>

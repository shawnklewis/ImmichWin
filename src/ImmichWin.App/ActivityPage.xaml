<Page
    x:Class="ImmichWin.App.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImmichWin.App">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="8">
        <TextBlock Text="Claude activity" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Classify existing photos…" Click="OnBackfill" />
            <Button Content="Refresh" Click="OnRefresh" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
        <ListView Grid.Row="2" x:Name="List" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ChangeRow">
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="4">
                        <TextBlock Text="{x:Bind Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="{x:Bind ActionText}" Click="OnAct" Tag="{x:Bind Id}" Visibility="{x:Bind CanAct}" Margin="4,0" />
                        <Button Grid.Column="2" Content="Reject" Click="OnReject" Tag="{x:Bind Id}" Visibility="{x:Bind IsPending}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBox Grid.Row="3" x:Name="LogBox" IsReadOnly="True" Height="120" AcceptsReturn="True" TextWrapping="Wrap" Header="Pipeline log" />
    </Grid>
</Page>
